# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode 

START hilow_game
    OUTPUT "Welcome to the higher/lower game!"

    # Establish a valid guessing range.
    Repeat
        OUTPUT "Enter the lower bound:"
        INPUT lower_bound
        OUTPUT  "Enter the upper bound:"
        INPUT upper_bound

        IF lower_bound >=  upper_bound THEN
            OUTPUT "The lower bound must be less than the upper bound."
        END IF
    UNTIL lower_bound < upper_bound

# Establish the number the player is trying to guess.
SET target_number to a random integer from lower_bound to upper_bound, inclusive

# Play the game.
REPEAT
    REPEAT
        OUTPUT "Guess a number between", lower_bound, "and", upper_bound
        INPUT guess

        IF guess < lower_bound OR guess > upper_bound THEN
            OUTPUT "Your guess must be within the chosen range."
        END IF
    UNTIL guess >= lower_bound AND guess <= upper_bound

    IF guess < target_number THEN
        OUTPUT "Nope, too low"
    ELSE IF guess > target_number THEN
        OUTPUT "Nope, too high."
    ELSE
        OUTPUT "You got it!"
    END IF
  UNTIL guess = target_number
END hilow_game



